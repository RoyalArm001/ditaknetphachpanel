# Server-only values. Never put real credentials in this tracked example.
RACKMAP_STORAGE=supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_KEY
POSTGRES_URL=postgresql://postgres.PROJECT:NEW_PASSWORD@YOUR_POOLER:6543/postgres
# Vercel integration names with supabase_ prefix are also accepted.
RACKMAP_ALLOWED_USER_IDS=
# Configure staff PIN with: npm run pin:setup
RACKMAP_PIN_HASH=
# Optional multiple local/server PINs as JSON: {"owner":"SALT:HASH","staff":"SALT:HASH"}
# Cloud PINs can instead be provisioned in protected database tables with npm run pin:cloud.
RACKMAP_PIN_HASHES=
RACKMAP_SESSION_SECRET=
# Paste trusted Supabase CA certificate contents into this server variable:
POSTGRES_SSL_CA_PEM=
# Public OAuth web client ID (no client secret). Enable Drive API and authorize
# https://patch.ditaknet.com in Google Cloud > OAuth > JavaScript origins.
GOOGLE_DRIVE_CLIENT_ID=
# Also add this origin to Supabase Authentication > URL Configuration.
RACKMAP_PUBLIC_URL=https://patch.ditaknet.com/
