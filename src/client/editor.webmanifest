{
  "id": "/",
  "name": "My Patch Editor",
  "short_name": "Editor",
  "description": "PDF floor plans, device planning and cable routes",
  "lang": "en",
  "start_url": "/#drawing",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f3f6f5",
  "theme_color": "#174e50",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "related_applications": [
    {
      "platform": "webapp",
      "url": "/editor.webmanifest",
      "id": "/"
    }
  ],
  "prefer_related_applications": false
}
